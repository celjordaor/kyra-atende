# ── Supabase ──────────────────────────────────────────────────
# Copie para .env.local e preencha com os valores do seu projeto.
# Dashboard Supabase → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhb...SEU_ANON_KEY

# ⚠️ NUNCA expor no frontend — usar apenas em route handlers e workers
SUPABASE_SERVICE_ROLE_KEY=eyJhb...SEU_SERVICE_ROLE_KEY

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
